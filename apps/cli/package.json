{
  "name": "@tianrendong/gt-cli",
  "version": "0.6.46",
  "description": "gt CLI with GitHub Stack synchronization and optional Graphite submission.",
  "license": "AGPL-3.0-only",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "homepage": "https://github.com/tianrendong/gt-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tianrendong/gt-cli.git",
    "directory": "apps/cli"
  },
  "keywords": [
    "git",
    "github",
    "graphite",
    "gt",
    "stacked-prs",
    "stacked-diffs",
    "stacked-changes"
  ],
  "dependencies": {
    "chalk": "^4.1.2",
    "fast-json-stable-hash": "^1.0.3",
    "fs-extra": "^10.1.0",
    "https-proxy-agent": "^7.0.6",
    "koffi": "^2.14.1",
    "prompts": "^2.4.2",
    "proxy-from-env": "^1.1.0",
    "semver": "^7.3.7",
    "strip-ansi": "^6.0.1",
    "tmp": "^0.2.1",
    "yargs": "^17.5.1"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prepack": "node ../../.yarn/releases/yarn-3.2.1.cjs workspace @tianrendong/gt-cli build && node scripts/package-source.cjs",
    "prepublishOnly": "node ../../.yarn/releases/yarn-3.2.1.cjs workspace @tianrendong/gt-cli build",
    "lint": "eslint src --quiet --ext .ts --cache",
    "check": "tsc --noEmit",
    "build": "rm -rf dist/ && yarn lint && tsc && node scripts/command-manifest.cjs && cp scripts/node_version.js dist/scripts/node_version.js && cp src/lib/gt.fish dist/src/lib/gt.fish",
    "dev": "./scripts/installation/develop.sh",
    "cli": "node ./dist/src/index.js",
    "test": "tsc && yarn mocha \"dist/test/**/*.test.js\"  --parallel --jobs 8",
    "test-ci": "tsc && nyc --reporter=lcovonly yarn mocha \"dist/test/**/*.test.js\"  --parallel --jobs 8",
    "test-one": "tsc && yarn mocha",
    "test-grep": "tsc && yarn mocha \"dist/test/**/*.test.js\" -g"
  },
  "nyc": {
    "exclude": ".yarn/**/*"
  },
  "files": [
    "dist/src",
    "dist/scripts/node_version.js",
    "dist/scripts/installation/output.cjs",
    "dist/scripts/installation/disable.cjs",
    "dist/scripts/installation/native_escape.cjs",
    "dist/scripts/migrate-from-graphite.cjs",
    "dist/scripts/sqlite.cjs",
    "dist/package.json",
    "README.md",
    "USAGE.md",
    "LICENSE",
    "source.tar.gz",
    "enable.sh",
    "disable.sh",
    "install.sh",
    "bin/gt-cli",
    "scripts/installation/install.cjs",
    "scripts/installation/install_tools.cjs",
    "scripts/installation/output.cjs",
    "scripts/installation/output.sh",
    "scripts/installation/run.sh",
    "scripts/installation/disable.cjs",
    "scripts/installation/disable-native.sh",
    "scripts/installation/native_escape.cjs",
    "scripts/installation/update.cjs"
  ],
  "bin": "bin/gt-cli",
  "engines": {
    "node": ">=18"
  },
  "runtimeEngines": {
    "node": "^22.16.0 || >=24.0.0"
  },
  "devDependencies": {
    "@types/chai": "^4.3.1",
    "@types/chai-as-promised": "^7.1.5",
    "@types/fs-extra": "^9.0.13",
    "@types/mocha": "^9.1.1",
    "@types/node": "^17.0.40",
    "@types/prettier": "^2",
    "@types/prompts": "^2.4.3",
    "@types/proxy-from-env": "^1.0.4",
    "@types/semver": "^7",
    "@types/tmp": "^0.2.3",
    "@types/yargs": "^17.0.10",
    "@typescript-eslint/eslint-plugin": "^5.27.1",
    "@typescript-eslint/parser": "^5.27.1",
    "chai": "^4.3.6",
    "chai-as-promised": "^7.1.1",
    "eslint": "^8.17.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-import-resolver-typescript": "3.6.1",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-prettier": "^4.2.1",
    "mocha": "^10.0.0",
    "nock": "^13.2.6",
    "nyc": "^15.1.0",
    "pinst": "^3.0.0",
    "prettier": "^2.8.3",
    "ts-node": "^10.8.1",
    "typescript": "^4.7.3"
  }
}
