{
  "private": true,
  "name": "graphite",
  "workspaces": {
    "packages": [
      "./apps/cli",
      "./libs/cli-shared-types"
    ]
  },
  "packageManager": "yarn@3.2.1",
  "scripts": {
    "build": "node .yarn/releases/yarn-3.2.1.cjs workspace @tianrendong/gt-cli build",
    "check": "node .yarn/releases/yarn-3.2.1.cjs workspace @tianrendong/gt-cli check",
    "lint": "node .yarn/releases/yarn-3.2.1.cjs workspace @tianrendong/gt-cli lint",
    "test": "node .yarn/releases/yarn-3.2.1.cjs workspace @tianrendong/gt-cli test",
    "test:parity": "node apps/cli/scripts/parity/local_repository.cjs",
    "test:output": "node apps/cli/scripts/parity/output.cjs",
    "test:pi": "node apps/cli/scripts/parity/pi_stack.cjs",
    "test:graphite": "node apps/cli/scripts/parity/pi_stack.cjs --graphite-cloud",
    "test:install": "node apps/cli/scripts/parity/installation.cjs",
    "test:update": "node apps/cli/scripts/parity/installation.cjs --update-tests",
    "migrate:graphite": "node apps/cli/scripts/migrate-from-graphite.cjs",
    "gt": "node apps/cli/dist/src/gt_cli.js"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.47.0",
    "@typescript-eslint/parser": "^5.47.0",
    "@yarnpkg/sdks": "^3.0.0-rc.34",
    "eslint": "^8.30.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-import-resolver-typescript": "3.6.1",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-simple-import-sort": "^8.0.0",
    "husky": "^8.0.1",
    "nyc": "^15.1.0",
    "prettier": "^2.8.1",
    "pretty-quick": "^3.1.3",
    "ts-mocha": "^10.0.0",
    "turbo": "^1.10.7",
    "typescript": "^4.9.4"
  }
}
